# App
APP_URL="http://localhost:3000"
NODE_ENV="development"

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/russian_tests_mvp?schema=public"

# Admin auth
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="ChangeMeAdmin123!"
ADMIN_PASSWORD_HASH=""
SESSION_SECRET="dev_only_replace_with_64_random_chars_before_production_1234567890"

# Product defaults
DEFAULT_SUBJECT="russian"
DEFAULT_CURRENCY="BYN"
DEFAULT_ACCESS_DAYS="7"
DEFAULT_ATTEMPTS_LIMIT="1"

# Payment
# Belarus-first. Exact provider must be approved before Sprint 5.
PAYMENT_PROVIDER="mock"
PAYMENT_MODE="sandbox"
ENABLE_MOCK_PAYMENTS="true"
PAYMENT_WEBHOOK_SECRET=""
PAYMENT_SUCCESS_URL=""
PAYMENT_FAIL_URL=""
PAYMENT_CURRENCY="BYN"

EXPRESSPAY_SANDBOX="true"
EXPRESSPAY_BASE_URL=""
EXPRESSPAY_TOKEN=""
EXPRESSPAY_SERVICE_ID=""
EXPRESSPAY_SECRET=""
EXPRESSPAY_NOTIFICATION_SECRET=""
EXPRESSPAY_NOTIFICATION_URL=""

BEPAID_SHOP_ID=""
BEPAID_SECRET_KEY=""
WEBPAY_STORE_ID=""
WEBPAY_SECRET_KEY=""
ERIP_SERVICE_CODE=""

# Commercial WebPay sandbox checkout. It stays disabled unless every required
# legal/support setting is present and PAYMENTS_MODE is webpay_sandbox.
COMMERCIAL_CHECKOUT_ENABLED="false"
PAYMENTS_MODE="disabled"
COMMERCIAL_FAKE_PROVIDER_TEST_ONLY="false"
COMMERCIAL_ORDER_TOKEN_HMAC_KEY=""
COMMERCIAL_PRODUCT_TEST_SLUG="russian_training_variant_01_corrected"
WEBPAY_SANDBOX_STORE_ID=""
WEBPAY_SANDBOX_SECRET_KEY=""
WEBPAY_SANDBOX_CHECKOUT_URL="https://secure.sandbox.webpay.by:8843/"
WEBPAY_SANDBOX_STATUS_URL=""
WEBPAY_SANDBOX_STORE_NAME=""
SUPPORT_EMAIL="kolyugova42@icloud.com"
SUPPORT_TELEGRAM=""
LEGAL_BUNDLE_VERSION=""
OFFER_URL="/offer"
PRIVACY_URL="/privacy"
REFUND_POLICY_URL="/refunds"
DISCLAIMER_URL="/service-delivery"

# Access codes
ACCESS_CODE_HASH_PEPPER="dev_only_replace_before_production_access_code_pepper_1234567890"

# Email
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="no-reply@example.com"

# Logging
LOG_LEVEL="info"

# First-party analytics. Disabled by default; never reuse another application secret.
ANALYTICS_ENABLED="false"
ANALYTICS_ID_HMAC_KEY=""
ANALYTICS_ID_KEY_VERSION=""

# Verified commercial student session foundation. Default-off and not connected
# to routes in ACC-01A. Key ring format: version:base64url-key[,version:key].
# Every decoded key must contain at least 32 bytes. Never reuse another app key.
VERIFIED_COMMERCIAL_SESSION_MODE="off"
VERIFIED_STUDENT_SESSION_ACTIVE_KEY_VERSION=""
VERIFIED_STUDENT_SESSION_HMAC_KEY_RING=""

# ACC-01A recovery foundation. Default-off, dev/test-only, and never a
# production mailer fallback. Key values stay empty in this example.
ACC_01A_RECOVERY_ENABLED=""
RECOVERY_MAILER_MODE=""
RECOVERY_COMMERCIAL_PRODUCT_CODE=""
RECOVERY_EMAIL_FINGERPRINT_ACTIVE_KEY_VERSION=""
RECOVERY_EMAIL_FINGERPRINT_HMAC_KEY_RING=""
RECOVERY_CHALLENGE_TOKEN_ACTIVE_KEY_VERSION=""
RECOVERY_CHALLENGE_TOKEN_HMAC_KEY_RING=""
RECOVERY_OTP_ACTIVE_KEY_VERSION=""
RECOVERY_OTP_HMAC_KEY_RING=""
RECOVERY_SESSION_TOKEN_ACTIVE_KEY_VERSION=""
RECOVERY_SESSION_TOKEN_HMAC_KEY_RING=""
