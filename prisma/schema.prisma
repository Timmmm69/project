generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN   @map("admin")
  STUDENT @map("student")

  @@map("user_role")
}

enum Subject {
  RUSSIAN @map("russian")

  @@map("subject")
}

enum TestMode {
  TRAINING @map("training")
  CE_CT    @map("ce_ct")

  @@map("test_mode")
}

enum ExamMode {
  GENERIC           @map("generic")
  RIKZ_RUSSIAN_2026 @map("rikz_russian_2026")

  @@map("exam_mode")
}

enum TestStatus {
  DRAFT     @map("draft")
  PUBLISHED @map("published")
  HIDDEN    @map("hidden")
  ARCHIVED  @map("archived")

  @@map("test_status")
}

enum QuestionType {
  SINGLE_CHOICE      @map("single_choice")
  MULTIPLE_CHOICE    @map("multiple_choice")
  SHORT_TEXT         @map("short_text")
  MULTI_SELECT_FIVE  @map("multi_select_five")
  SHORT_ANSWER_TOKEN @map("short_answer_token")

  @@map("question_type")
}

enum OfficialPart {
  A @map("A")
  B @map("B")

  @@map("official_part")
}

enum ResponseSubtype {
  WORD   @map("word")
  DIGITS @map("digits")
  ALNUM  @map("alnum")

  @@map("response_subtype")
}

enum Difficulty {
  EASY   @map("easy")
  MEDIUM @map("medium")
  HARD   @map("hard")

  @@map("difficulty")
}

enum ScoringRule {
  FULL_MATCH @map("full_match")
  EXACT_TEXT @map("exact_text")

  @@map("scoring_rule")
}

enum PaymentStatus {
  PENDING   @map("pending")
  SUCCESS   @map("success")
  FAILED    @map("failed")
  CANCELLED @map("cancelled")
  EXPIRED   @map("expired")
  REFUNDED  @map("refunded")

  @@map("payment_status")
}

enum PaymentProvider {
  MOCK            @map("mock")
  MANUAL          @map("manual")
  BEPAID          @map("bepaid")
  WEBPAY          @map("webpay")
  ERIP            @map("erip")
  EXPRESSPAY_EPOS @map("expresspay_epos")
  OTHER           @map("other")

  @@map("payment_provider")
}

enum AccessSource {
  PAYMENT     @map("payment")
  MANUAL      @map("manual")
  ACCESS_CODE @map("access_code")
  COMMERCIAL  @map("commercial")

  @@map("access_source")
}

enum CommercialOrderStatus {
  CREATED   @map("created")
  PENDING   @map("pending")
  PAID      @map("paid")
  FAILED    @map("failed")
  CANCELLED @map("cancelled")
  EXPIRED   @map("expired")

  @@map("commercial_order_status")
}

enum CommercialPaymentProvider {
  WEBPAY_SANDBOX @map("webpay_sandbox")
  LOCAL_FAKE     @map("local_fake")

  @@map("commercial_payment_provider")
}

enum CommercialPaymentAttemptStatus {
  CREATED   @map("created")
  PENDING   @map("pending")
  PAID      @map("paid")
  FAILED    @map("failed")
  CANCELLED @map("cancelled")
  EXPIRED   @map("expired")

  @@map("commercial_payment_attempt_status")
}

enum CommercialPaymentEventStatus {
  RECEIVED  @map("received")
  PROCESSED @map("processed")
  REJECTED  @map("rejected")

  @@map("commercial_payment_event_status")
}

enum AccessCodeStatus {
  ACTIVE  @map("active")
  USED    @map("used")
  EXPIRED @map("expired")
  REVOKED @map("revoked")

  @@map("access_code_status")
}

enum VerifiedStudentSessionSource {
  EMAIL_OTP_RECOVERY     @map("email_otp_recovery")
  ACCESS_CODE            @map("access_code")
  COMMERCIAL_ORDER_CLAIM @map("commercial_order_claim")

  @@map("verified_student_session_source")
}

enum VerifiedStudentSessionRevocationReason {
  LOGOUT           @map("logout")
  EXPIRED          @map("expired")
  ROTATED          @map("rotated")
  ACCESS_REVOKED   @map("access_revoked")
  SECURITY_REVOKED @map("security_revoked")
  KEY_RETIRED      @map("key_retired")

  @@map("verified_student_session_revocation_reason")
}

enum RecoveryChallengeStatus {
  ACTIVE     @map("active")
  VERIFIED   @map("verified")
  EXPIRED    @map("expired")
  LOCKED     @map("locked")
  SUPERSEDED @map("superseded")
  REVOKED    @map("revoked")

  @@map("recovery_challenge_status")
}

enum RecoveryVerificationOutcome {
  MATCH    @map("match")
  NO_MATCH @map("no_match")
  EXPIRED  @map("expired")
  LOCKED   @map("locked")
  REPLAY   @map("replay")
  ERROR    @map("error")

  @@map("recovery_verification_outcome")
}

enum VerifiedRecoverySessionStatus {
  ACTIVE  @map("active")
  REVOKED @map("revoked")
  EXPIRED @map("expired")
  ROTATED @map("rotated")

  @@map("verified_recovery_session_status")
}

enum VerifiedRecoverySessionRevocationCode {
  USER_INVALIDATED @map("user_invalidated")
  EXPIRED          @map("expired")
  ROTATED          @map("rotated")
  CONTINUED        @map("continued")
  SECURITY_REVOKED @map("security_revoked")
  KEY_RETIRED      @map("key_retired")

  @@map("verified_recovery_session_revocation_code")
}

enum RecoveryRateLimitKind {
  EMAIL_REQUEST         @map("email_request")
  SOURCE_REQUEST        @map("source_request")
  SOURCE_VERIFY_FAILURE @map("source_verify_failure")

  @@map("recovery_rate_limit_kind")
}

enum RecoverySecurityEventCode {
  CHALLENGE_REQUESTED  @map("challenge_requested")
  CHALLENGE_REUSED     @map("challenge_reused")
  CHALLENGE_SUPERSEDED @map("challenge_superseded")
  VERIFY_REJECTED      @map("verify_rejected")
  VERIFY_MATCHED       @map("verify_matched")
  RATE_LIMITED         @map("rate_limited")
  SESSION_ISSUED       @map("session_issued")
  SESSION_REVOKED      @map("session_revoked")

  @@map("recovery_security_event_code")
}

enum RecoverySecurityReasonCode {
  REQUEST_CREATED    @map("request_created")
  IDEMPOTENT_RETRY   @map("idempotent_retry")
  RESEND             @map("resend")
  COOLDOWN           @map("cooldown")
  EMAIL_LIMIT        @map("email_limit")
  SOURCE_LIMIT       @map("source_limit")
  INVALID_OTP        @map("invalid_otp")
  CHALLENGE_EXPIRED  @map("challenge_expired")
  CHALLENGE_LOCKED   @map("challenge_locked")
  CHALLENGE_REPLAY   @map("challenge_replay")
  MAILER_FAILED      @map("mailer_failed")
  MAILER_UNKNOWN     @map("mailer_unknown")
  OTP_MATCH          @map("otp_match")
  USER_INVALIDATED   @map("user_invalidated")
  SESSION_EXPIRED    @map("session_expired")
  SESSION_ROTATED    @map("session_rotated")
  SESSION_CONTINUED  @map("session_continued")
  SECURITY_REVOKED   @map("security_revoked")
  KEY_RETIRED        @map("key_retired")
  SCOPE_INVALID      @map("scope_invalid")
  OPERATION_CONFLICT @map("operation_conflict")

  @@map("recovery_security_reason_code")
}

enum AttemptStatus {
  STARTED   @map("started")
  COMPLETED @map("completed")
  EXPIRED   @map("expired")
  CANCELLED @map("cancelled")

  @@map("attempt_status")
}

enum ImportMode {
  APPEND  @map("append")
  REPLACE @map("replace")

  @@map("import_mode")
}

enum ImportJobStatus {
  UPLOADED  @map("uploaded")
  VALIDATED @map("validated")
  FAILED    @map("failed")
  IMPORTED  @map("imported")
  CANCELLED @map("cancelled")

  @@map("import_job_status")
}

enum EmailStatus {
  PENDING @map("pending")
  SENT    @map("sent")
  FAILED  @map("failed")

  @@map("email_status")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  name         String?
  role         UserRole  @default(STUDENT)
  passwordHash String?   @map("password_hash")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  payments                Payment[]                @relation("PaymentUser")
  accesses                Access[]                 @relation("AccessUser")
  attempts                Attempt[]                @relation("AttemptUser")
  createdTests            Test[]                   @relation("TestCreatedByAdmin")
  createdAccesses         Access[]                 @relation("AccessCreatedByAdmin")
  revokedAccesses         Access[]                 @relation("AccessRevokedByAdmin")
  createdAccessCodes      AccessCode[]             @relation("AccessCodeCreatedByAdmin")
  activatedAccessCodes    AccessCode[]             @relation("AccessCodeActivatedByUser")
  revokedAccessCodes      AccessCode[]             @relation("AccessCodeRevokedByAdmin")
  importJobs              ImportJob[]              @relation("ImportJobAdmin")
  manualAccessAdminLogs   ManualAccessLog[]        @relation("ManualAccessAdmin")
  manualAccessUserLogs    ManualAccessLog[]        @relation("ManualAccessUser")
  eventLogs               EventLog[]               @relation("EventLogActor")
  emailLogs               EmailLog[]               @relation("EmailLogUser")
  verifiedStudentSessions VerifiedStudentSession[]

  @@index([role])
  @@map("users")
}

model Test {
  id                  String     @id @default(uuid()) @db.Uuid
  title               String
  slug                String     @unique
  subject             Subject    @default(RUSSIAN)
  mode                TestMode   @default(TRAINING)
  examMode            ExamMode   @default(GENERIC) @map("exam_mode")
  subjectCode         String?    @map("subject_code")
  officialYear        Int?       @map("official_year")
  shortDescription    String?    @map("short_description")
  fullDescription     String?    @map("full_description")
  price               Int
  currency            String     @default("BYN")
  durationMinutes     Int        @map("duration_minutes")
  attemptsLimit       Int        @default(1) @map("attempts_limit")
  accessDays          Int        @default(7) @map("access_days")
  status              TestStatus @default(DRAFT)
  questionsCount      Int        @default(0) @map("questions_count")
  maxRawScore         Int        @default(0) @map("max_raw_score")
  scoringSchemeId     String?    @map("scoring_scheme_id") @db.Uuid
  showScaledScore     Boolean    @default(false) @map("show_scaled_score")
  showPercent         Boolean    @default(true) @map("show_percent")
  showCorrectAnswers  Boolean    @default(true) @map("show_correct_answers")
  showTopicResult     Boolean    @default(true) @map("show_topic_result")
  showRecommendations Boolean    @default(true) @map("show_recommendations")
  publishedAt         DateTime?  @map("published_at")
  createdByAdminId    String?    @map("created_by_admin_id") @db.Uuid
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")
  deletedAt           DateTime?  @map("deleted_at")

  createdByAdmin           User?                     @relation("TestCreatedByAdmin", fields: [createdByAdminId], references: [id])
  scoringScheme            ScoringScheme?            @relation(fields: [scoringSchemeId], references: [id])
  questions                Question[]
  payments                 Payment[]
  accesses                 Access[]
  accessCodes              AccessCode[]
  attempts                 Attempt[]
  importJobs               ImportJob[]
  manualLogs               ManualAccessLog[]
  commercialProducts       CommercialProduct[]
  verifiedStudentSessions  VerifiedStudentSession[]
  recoveryChallenges       RecoveryChallenge[]
  verifiedRecoverySessions VerifiedRecoverySession[]

  @@index([status])
  @@index([subject])
  @@index([mode])
  @@index([examMode])
  @@map("tests")
}

model Question {
  id                  String           @id @default(uuid()) @db.Uuid
  testId              String           @map("test_id") @db.Uuid
  questionText        String           @map("question_text")
  questionType        QuestionType     @map("question_type")
  optionA             String?          @map("option_a")
  optionB             String?          @map("option_b")
  optionC             String?          @map("option_c")
  optionD             String?          @map("option_d")
  optionE             String?          @map("option_e")
  correctAnswer       String           @map("correct_answer")
  topic               String
  subtopic            String?
  difficulty          Difficulty?      @default(MEDIUM)
  points              Int              @default(1)
  scoringRule         ScoringRule      @default(FULL_MATCH) @map("scoring_rule")
  explanation         String?
  source              String?
  officialPart        OfficialPart?    @map("official_part")
  officialNumber      Int?             @map("official_number")
  responseSubtype     ResponseSubtype? @map("response_subtype")
  partialPolicy       String?          @map("partial_policy")
  acceptedAnswers     Json?            @map("accepted_answers_json")
  normalizationPolicy Json?            @map("normalization_policy_json")
  expertReviewerName  String?          @map("expert_reviewer_name")
  expertReviewedAt    DateTime?        @map("expert_reviewed_at")
  orderIndex          Int              @map("order_index")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")
  deletedAt           DateTime?        @map("deleted_at")

  test    Test     @relation(fields: [testId], references: [id])
  answers Answer[]

  @@index([testId])
  @@index([topic])
  @@index([testId, orderIndex])
  @@index([testId, officialPart, officialNumber])
  @@index([questionType])
  @@map("questions")
}

model Payment {
  id                     String          @id @default(uuid()) @db.Uuid
  userId                 String          @map("user_id") @db.Uuid
  testId                 String          @map("test_id") @db.Uuid
  amount                 Int
  currency               String          @default("BYN")
  status                 PaymentStatus   @default(PENDING)
  provider               PaymentProvider
  providerPaymentId      String?         @map("provider_payment_id")
  providerInvoiceId      String?         @map("provider_invoice_id")
  providerAccountNumber  String?         @map("provider_account_number")
  paymentUrl             String?         @map("payment_url")
  qrCodeUrl              String?         @map("qr_code_url")
  qrCodePayload          String?         @map("qr_code_payload")
  paymentInstructions    String?         @map("payment_instructions")
  providerStatus         String?         @map("provider_status")
  providerPayload        Json?           @map("provider_payload_json")
  providerWebhookPayload Json?           @map("provider_webhook_payload_json")
  npdReceiptRequired     Boolean         @default(false) @map("npd_receipt_required")
  npdReceiptCreated      Boolean         @default(false) @map("npd_receipt_created")
  npdReceiptCreatedAt    DateTime?       @map("npd_receipt_created_at")
  npdReceiptNote         String?         @map("npd_receipt_note")
  createdAt              DateTime        @default(now()) @map("created_at")
  updatedAt              DateTime        @updatedAt @map("updated_at")
  paidAt                 DateTime?       @map("paid_at")
  failedAt               DateTime?       @map("failed_at")
  cancelledAt            DateTime?       @map("cancelled_at")
  expiredAt              DateTime?       @map("expired_at")
  refundedAt             DateTime?       @map("refunded_at")

  user   User    @relation("PaymentUser", fields: [userId], references: [id])
  test   Test    @relation(fields: [testId], references: [id])
  access Access?

  @@unique([provider, providerPaymentId])
  @@index([provider])
  @@index([userId])
  @@index([testId])
  @@index([status])
  @@index([providerStatus])
  @@index([npdReceiptRequired, npdReceiptCreated])
  @@map("payments")
}

model Access {
  id                         String       @id @default(uuid()) @db.Uuid
  publicId                   String       @unique @default(cuid()) @map("public_id")
  userId                     String       @map("user_id") @db.Uuid
  testId                     String       @map("test_id") @db.Uuid
  paymentId                  String?      @unique @map("payment_id") @db.Uuid
  accessCodeId               String?      @unique @map("access_code_id") @db.Uuid
  source                     AccessSource
  attemptsTotal              Int          @default(1) @map("attempts_total")
  attemptsAvailable          Int          @default(1) @map("attempts_available")
  expiresAt                  DateTime     @map("expires_at")
  revokedAt                  DateTime?    @map("revoked_at")
  revokedByAdminId           String?      @map("revoked_by_admin_id") @db.Uuid
  revokedReason              String?      @map("revoked_reason")
  createdByAdminId           String?      @map("created_by_admin_id") @db.Uuid
  commercialProductId        String?      @map("commercial_product_id") @db.Uuid
  commercialOrderId          String?      @unique @map("commercial_order_id") @db.Uuid
  commercialPaymentAttemptId String?      @unique @map("commercial_payment_attempt_id") @db.Uuid
  grantedAt                  DateTime?    @map("granted_at")
  startDeadlineAt            DateTime?    @map("start_deadline_at")
  createdAt                  DateTime     @default(now()) @map("created_at")
  updatedAt                  DateTime     @updatedAt @map("updated_at")

  user                     User                      @relation("AccessUser", fields: [userId], references: [id])
  test                     Test                      @relation(fields: [testId], references: [id])
  payment                  Payment?                  @relation(fields: [paymentId], references: [id])
  accessCode               AccessCode?               @relation(fields: [accessCodeId], references: [id])
  revokedByAdmin           User?                     @relation("AccessRevokedByAdmin", fields: [revokedByAdminId], references: [id])
  createdByAdmin           User?                     @relation("AccessCreatedByAdmin", fields: [createdByAdminId], references: [id])
  commercialProduct        CommercialProduct?        @relation(fields: [commercialProductId], references: [id])
  commercialOrder          CommercialOrder?          @relation(fields: [commercialOrderId], references: [id])
  commercialPaymentAttempt CommercialPaymentAttempt? @relation(fields: [commercialPaymentAttemptId], references: [id])
  attempts                 Attempt[]
  manualLogs               ManualAccessLog[]
  verifiedStudentSessions  VerifiedStudentSession[]

  @@index([userId])
  @@index([testId])
  @@index([userId, testId])
  @@index([expiresAt])
  @@index([commercialProductId])
  @@map("accesses")
}

model CommercialProduct {
  id                  String   @id @default(uuid()) @db.Uuid
  code                String   @unique
  testId              String   @map("test_id") @db.Uuid
  name                String
  priceMinor          Int      @map("price_minor")
  currency            String   @default("BYN")
  attemptLimit        Int      @default(1) @map("attempt_limit")
  startWindowDays     Int      @default(90) @map("start_window_days")
  resultRetentionDays Int      @default(365) @map("result_retention_days")
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  test                     Test                      @relation(fields: [testId], references: [id])
  orders                   CommercialOrder[]
  checkoutFlows            CommercialCheckoutFlow[]
  accesses                 Access[]
  verifiedStudentSessions  VerifiedStudentSession[]
  recoveryChallenges       RecoveryChallenge[]
  verifiedRecoverySessions VerifiedRecoverySession[]

  @@index([testId])
  @@index([isActive])
  @@map("commercial_products")
}

model CommercialCheckoutFlow {
  id                  String   @id @db.Uuid
  commercialProductId String   @map("commercial_product_id") @db.Uuid
  testIdSnapshot      String   @map("test_id_snapshot") @db.Uuid
  examModeSnapshot    ExamMode @map("exam_mode_snapshot")
  createdAt           DateTime @default(now()) @map("created_at")

  product CommercialProduct @relation(fields: [commercialProductId], references: [id])
  order   CommercialOrder?

  @@index([commercialProductId])
  @@index([testIdSnapshot])
  @@map("commercial_checkout_flows")
}

model CommercialOrder {
  id                    String                @id @default(uuid()) @db.Uuid
  publicId              String                @unique @default(cuid()) @map("public_id")
  commercialProductId   String                @map("commercial_product_id") @db.Uuid
  testIdSnapshot        String                @map("test_id_snapshot") @db.Uuid
  productNameSnapshot   String                @map("product_name_snapshot")
  priceMinor            Int                   @map("price_minor")
  currency              String                @default("BYN")
  emailOriginal         String                @map("email_original")
  emailNormalized       String                @map("email_normalized")
  status                CommercialOrderStatus @default(CREATED)
  offerVersion          String                @map("offer_version")
  privacyVersion        String                @map("privacy_version")
  refundPolicyVersion   String                @map("refund_policy_version")
  disclaimerVersion     String                @map("disclaimer_version")
  adultBuyerConfirmedAt DateTime              @map("adult_buyer_confirmed_at")
  idempotencyKey        String                @map("idempotency_key")
  checkoutFlowId        String?               @unique @map("checkout_flow_id") @db.Uuid
  lookupTokenHash       String                @map("lookup_token_hash")
  paidAt                DateTime?             @map("paid_at")
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")

  product         CommercialProduct          @relation(fields: [commercialProductId], references: [id])
  checkoutFlow    CommercialCheckoutFlow?    @relation(fields: [checkoutFlowId], references: [id])
  paymentAttempts CommercialPaymentAttempt[]
  access          Access?

  @@unique([commercialProductId, idempotencyKey])
  @@index([emailNormalized, status])
  @@index([testIdSnapshot])
  @@map("commercial_orders")
}

model CommercialPaymentAttempt {
  id                     String                         @id @default(uuid()) @db.Uuid
  publicId               String                         @unique @default(cuid()) @map("public_id")
  commercialOrderId      String                         @map("commercial_order_id") @db.Uuid
  provider               CommercialPaymentProvider
  merchantReference      String                         @unique @map("merchant_reference")
  providerPaymentId      String?                        @map("provider_payment_id")
  status                 CommercialPaymentAttemptStatus @default(CREATED)
  amountMinor            Int                            @map("amount_minor")
  currency               String                         @default("BYN")
  paymentUrl             String?                        @map("payment_url")
  providerFields         Json?                          @map("provider_fields_json")
  expiresAt              DateTime?                      @map("expires_at")
  verifiedAt             DateTime?                      @map("verified_at")
  paidAt                 DateTime?                      @map("paid_at")
  failureCode            String?                        @map("failure_code")
  failureMessageSafe     String?                        @map("failure_message_safe")
  checkoutIdempotencyKey String?                        @map("checkout_idempotency_key")
  createdAt              DateTime                       @default(now()) @map("created_at")
  updatedAt              DateTime                       @updatedAt @map("updated_at")

  order  CommercialOrder          @relation(fields: [commercialOrderId], references: [id])
  events CommercialPaymentEvent[]
  access Access?

  @@unique([commercialOrderId, checkoutIdempotencyKey])
  @@unique([provider, providerPaymentId])
  @@index([commercialOrderId, status])
  @@map("commercial_payment_attempts")
}

model CommercialPaymentEvent {
  id                         String                       @id @default(uuid()) @db.Uuid
  commercialPaymentAttemptId String?                      @map("commercial_payment_attempt_id") @db.Uuid
  provider                   CommercialPaymentProvider
  providerEventKey           String?                      @map("provider_event_key")
  payloadHash                String                       @map("payload_hash")
  eventType                  String                       @map("event_type")
  signatureValid             Boolean                      @map("signature_valid")
  processingStatus           CommercialPaymentEventStatus @default(RECEIVED) @map("processing_status")
  processingErrorCode        String?                      @map("processing_error_code")
  redactedPayload            Json?                        @map("redacted_payload_json")
  receivedAt                 DateTime                     @default(now()) @map("received_at")
  processedAt                DateTime?                    @map("processed_at")

  paymentAttempt CommercialPaymentAttempt? @relation(fields: [commercialPaymentAttemptId], references: [id])

  @@unique([provider, payloadHash])
  @@index([commercialPaymentAttemptId])
  @@index([provider, providerEventKey])
  @@map("commercial_payment_events")
}

model VerifiedStudentSession {
  id                    String                                  @id @default(uuid()) @db.Uuid
  tokenDigest           String                                  @unique @map("token_digest") @db.Char(64)
  tokenKeyVersion       String                                  @map("token_key_version") @db.VarChar(32)
  tokenGeneration       Int                                     @default(1) @map("token_generation")
  userId                String                                  @map("user_id") @db.Uuid
  commercialProductId   String                                  @map("commercial_product_id") @db.Uuid
  testId                String                                  @map("test_id") @db.Uuid
  accessId              String                                  @map("access_id") @db.Uuid
  source                VerifiedStudentSessionSource
  sourceReferenceId     String                                  @map("source_reference_id") @db.Uuid
  issuanceOperationId   String                                  @map("issuance_operation_id") @db.Uuid
  issuedAt              DateTime                                @default(now()) @map("issued_at")
  expiresAt             DateTime                                @map("expires_at")
  lastRotatedAt         DateTime?                               @map("last_rotated_at")
  revokedAt             DateTime?                               @map("revoked_at")
  revocationReason      VerifiedStudentSessionRevocationReason? @map("revocation_reason")
  securityCorrelationId String                                  @unique @map("security_correlation_id") @db.Uuid
  createdAt             DateTime                                @default(now()) @map("created_at")
  updatedAt             DateTime                                @updatedAt @map("updated_at")

  user    User              @relation(fields: [userId], references: [id])
  product CommercialProduct @relation(fields: [commercialProductId], references: [id])
  test    Test              @relation(fields: [testId], references: [id])
  access  Access            @relation(fields: [accessId], references: [id])

  @@unique([source, sourceReferenceId, issuanceOperationId])
  @@index([userId, commercialProductId, testId, expiresAt])
  @@index([accessId, expiresAt])
  @@index([tokenKeyVersion, expiresAt])
  @@map("verified_student_sessions")
}

model RecoveryChallenge {
  id                   String                  @id @default(uuid()) @db.Uuid
  commercialProductId  String                  @map("commercial_product_id") @db.Uuid
  testId               String                  @map("test_id") @db.Uuid
  emailNormalized      String                  @map("email_normalized")
  emailFingerprint     String                  @map("email_fingerprint") @db.Char(64)
  challengeTokenDigest String                  @unique @map("challenge_token_digest") @db.Char(64)
  challengeKeyVersion  String                  @map("challenge_key_version") @db.VarChar(32)
  otpMac               String?                 @map("otp_mac") @db.Char(64)
  otpKeyVersion        String                  @map("otp_key_version") @db.VarChar(32)
  status               RecoveryChallengeStatus @default(ACTIVE)
  failedVerifyCount    Int                     @default(0) @map("failed_verify_count")
  requestOperationId   String                  @unique @map("request_operation_id") @db.Uuid
  expiresAt            DateTime                @map("expires_at")
  resendAvailableAt    DateTime                @map("resend_available_at")
  verifiedAt           DateTime?               @map("verified_at")
  terminalAt           DateTime?               @map("terminal_at")
  supersededById       String?                 @map("superseded_by_id") @db.Uuid
  createdAt            DateTime                @default(now()) @map("created_at")
  updatedAt            DateTime                @updatedAt @map("updated_at")

  product              CommercialProduct             @relation(fields: [commercialProductId], references: [id])
  test                 Test                          @relation(fields: [testId], references: [id])
  supersededBy         RecoveryChallenge?            @relation("RecoveryChallengeSupersession", fields: [supersededById], references: [id])
  supersedes           RecoveryChallenge[]           @relation("RecoveryChallengeSupersession")
  verificationAttempts RecoveryVerificationAttempt[]
  recoverySessions     VerifiedRecoverySession[]
  securityEvents       RecoverySecurityEvent[]

  @@index([emailFingerprint, commercialProductId, testId, status], map: "recovery_challenges_subject_scope_status_idx")
  @@index([status, expiresAt])
  @@index([emailFingerprint, commercialProductId, testId, resendAvailableAt], map: "recovery_challenges_subject_scope_cooldown_idx")
  @@index([status, terminalAt])
  @@map("recovery_challenges")
}

model RecoveryVerificationAttempt {
  id             String                      @id @default(uuid()) @db.Uuid
  challengeId    String                      @map("challenge_id") @db.Uuid
  operationId    String                      @unique @map("operation_id") @db.Uuid
  outcomeCode    RecoveryVerificationOutcome @map("outcome_code")
  attemptOrdinal Int                         @map("attempt_ordinal")
  occurredAt     DateTime                    @default(now()) @map("occurred_at")

  challenge RecoveryChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@index([challengeId, occurredAt])
  @@map("recovery_verification_attempts")
}

model VerifiedRecoverySession {
  id                  String                                 @id @default(uuid()) @db.Uuid
  challengeId         String                                 @unique @map("challenge_id") @db.Uuid
  tokenDigest         String                                 @unique @map("token_digest") @db.Char(64)
  tokenKeyVersion     String                                 @map("token_key_version") @db.VarChar(32)
  emailNormalized     String                                 @map("email_normalized")
  emailFingerprint    String                                 @map("email_fingerprint") @db.Char(64)
  commercialProductId String                                 @map("commercial_product_id") @db.Uuid
  testId              String                                 @map("test_id") @db.Uuid
  status              VerifiedRecoverySessionStatus          @default(ACTIVE)
  issuedAt            DateTime                               @default(now()) @map("issued_at")
  expiresAt           DateTime                               @map("expires_at")
  lastUsedAt          DateTime?                              @map("last_used_at")
  revokedAt           DateTime?                              @map("revoked_at")
  revocationCode      VerifiedRecoverySessionRevocationCode? @map("revocation_code")
  rotatedFromId       String?                                @map("rotated_from_id") @db.Uuid
  createdAt           DateTime                               @default(now()) @map("created_at")
  updatedAt           DateTime                               @updatedAt @map("updated_at")

  challenge      RecoveryChallenge         @relation(fields: [challengeId], references: [id])
  product        CommercialProduct         @relation(fields: [commercialProductId], references: [id])
  test           Test                      @relation(fields: [testId], references: [id])
  rotatedFrom    VerifiedRecoverySession?  @relation("VerifiedRecoverySessionRotation", fields: [rotatedFromId], references: [id])
  rotations      VerifiedRecoverySession[] @relation("VerifiedRecoverySessionRotation")
  securityEvents RecoverySecurityEvent[]

  @@index([emailFingerprint, commercialProductId, testId, status], map: "verified_recovery_sessions_subject_scope_status_idx")
  @@index([status, expiresAt])
  @@index([status, revokedAt])
  @@index([tokenKeyVersion, expiresAt])
  @@map("verified_recovery_sessions")
}

model RecoveryRateLimitEvent {
  id         String                @id @default(uuid()) @db.Uuid
  kind       RecoveryRateLimitKind
  keyDigest  String                @map("key_digest") @db.Char(64)
  occurredAt DateTime              @default(now()) @map("occurred_at")
  expiresAt  DateTime              @map("expires_at")

  @@index([kind, keyDigest, occurredAt])
  @@index([expiresAt])
  @@map("recovery_rate_limit_events")
}

model RecoverySecurityEvent {
  id                String                      @id @default(uuid()) @db.Uuid
  correlationId     String                      @map("correlation_id") @db.Uuid
  eventCode         RecoverySecurityEventCode   @map("event_code")
  challengeId       String?                     @map("challenge_id") @db.Uuid
  recoverySessionId String?                     @map("recovery_session_id") @db.Uuid
  reasonCode        RecoverySecurityReasonCode? @map("reason_code")
  occurredAt        DateTime                    @default(now()) @map("occurred_at")

  challenge       RecoveryChallenge?       @relation(fields: [challengeId], references: [id], onDelete: SetNull)
  recoverySession VerifiedRecoverySession? @relation(fields: [recoverySessionId], references: [id], onDelete: SetNull)

  @@index([challengeId, occurredAt])
  @@index([recoverySessionId, occurredAt])
  @@index([eventCode, occurredAt])
  @@index([occurredAt])
  @@map("recovery_security_events")
}

model AccessCode {
  id                String           @id @default(uuid()) @db.Uuid
  codeHash          String           @unique @map("code_hash")
  testId            String           @map("test_id") @db.Uuid
  createdByAdminId  String           @map("created_by_admin_id") @db.Uuid
  status            AccessCodeStatus @default(ACTIVE)
  attemptsTotal     Int              @default(1) @map("attempts_total")
  accessDays        Int              @default(7) @map("access_days")
  codeExpiresAt     DateTime         @map("code_expires_at")
  activatedByUserId String?          @map("activated_by_user_id") @db.Uuid
  activatedAt       DateTime?        @map("activated_at")
  revokedAt         DateTime?        @map("revoked_at")
  revokedByAdminId  String?          @map("revoked_by_admin_id") @db.Uuid
  revokedReason     String?          @map("revoked_reason")
  comment           String?
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  test            Test    @relation(fields: [testId], references: [id])
  createdByAdmin  User    @relation("AccessCodeCreatedByAdmin", fields: [createdByAdminId], references: [id])
  activatedByUser User?   @relation("AccessCodeActivatedByUser", fields: [activatedByUserId], references: [id])
  revokedByAdmin  User?   @relation("AccessCodeRevokedByAdmin", fields: [revokedByAdminId], references: [id])
  access          Access?

  @@index([testId])
  @@index([status])
  @@index([codeExpiresAt])
  @@map("access_codes")
}

model Attempt {
  id                    String        @id @default(uuid()) @db.Uuid
  userId                String        @map("user_id") @db.Uuid
  testId                String        @map("test_id") @db.Uuid
  accessId              String        @map("access_id") @db.Uuid
  status                AttemptStatus @default(STARTED)
  startedAt             DateTime      @default(now()) @map("started_at")
  finishedAt            DateTime?     @map("finished_at")
  durationSeconds       Int?          @map("duration_seconds")
  rawScore              Int?          @map("raw_score")
  maxRawScore           Int?          @map("max_raw_score")
  percent               Decimal?      @db.Decimal(5, 2)
  scaledScore           Int?          @map("scaled_score")
  maxScaledScore        Int?          @map("max_scaled_score")
  level                 String?
  testSnapshot          Json          @map("test_snapshot_json")
  scoringSchemeSnapshot Json?         @map("scoring_scheme_snapshot_json")
  topicResults          Json?         @map("topic_results_json")
  recommendations       Json?         @map("recommendations_json")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  user    User     @relation("AttemptUser", fields: [userId], references: [id])
  test    Test     @relation(fields: [testId], references: [id])
  access  Access   @relation(fields: [accessId], references: [id])
  answers Answer[]

  @@index([userId])
  @@index([testId])
  @@index([accessId])
  @@index([status])
  @@index([startedAt])
  @@map("attempts")
}

model Answer {
  id                 String    @id @default(uuid()) @db.Uuid
  attemptId          String    @map("attempt_id") @db.Uuid
  questionId         String?   @map("question_id") @db.Uuid
  snapshotQuestionId String?   @map("snapshot_question_id")
  questionSnapshot   Json      @map("question_snapshot_json")
  selectedAnswer     String?   @map("selected_answer")
  isCorrect          Boolean?  @map("is_correct")
  pointsEarned       Int?      @map("points_earned")
  maxPoints          Int       @map("max_points")
  answeredAt         DateTime? @map("answered_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  attempt  Attempt   @relation(fields: [attemptId], references: [id])
  question Question? @relation(fields: [questionId], references: [id])

  @@unique([attemptId, snapshotQuestionId])
  @@index([attemptId])
  @@index([questionId])
  @@map("answers")
}

model ImportJob {
  id          String          @id @default(uuid()) @db.Uuid
  testId      String          @map("test_id") @db.Uuid
  adminId     String          @map("admin_id") @db.Uuid
  fileName    String          @map("file_name")
  fileType    String          @map("file_type")
  mode        ImportMode
  status      ImportJobStatus @default(UPLOADED)
  totalRows   Int?            @map("total_rows")
  validRows   Int?            @map("valid_rows")
  errorRows   Int?            @map("error_rows")
  warningRows Int?            @map("warning_rows")
  errors      Json?           @map("errors_json")
  warnings    Json?           @map("warnings_json")
  preview     Json?           @map("preview_json")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  validatedAt DateTime?       @map("validated_at")
  importedAt  DateTime?       @map("imported_at")

  test  Test @relation(fields: [testId], references: [id])
  admin User @relation("ImportJobAdmin", fields: [adminId], references: [id])

  @@index([testId])
  @@index([adminId])
  @@index([status])
  @@map("import_jobs")
}

model ManualAccessLog {
  id            String   @id @default(uuid()) @db.Uuid
  adminId       String   @map("admin_id") @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  testId        String   @map("test_id") @db.Uuid
  accessId      String   @map("access_id") @db.Uuid
  attemptsTotal Int      @map("attempts_total")
  accessDays    Int      @map("access_days")
  comment       String?
  createdAt     DateTime @default(now()) @map("created_at")

  admin  User   @relation("ManualAccessAdmin", fields: [adminId], references: [id])
  user   User   @relation("ManualAccessUser", fields: [userId], references: [id])
  test   Test   @relation(fields: [testId], references: [id])
  access Access @relation(fields: [accessId], references: [id])

  @@index([adminId])
  @@index([userId])
  @@index([testId])
  @@index([accessId])
  @@map("manual_access_logs")
}

model EventLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  eventType   String   @map("event_type")
  entityType  String?  @map("entity_type")
  entityId    String?  @map("entity_id") @db.Uuid
  payload     Json?    @map("payload_json")
  createdAt   DateTime @default(now()) @map("created_at")

  actorUser User? @relation("EventLogActor", fields: [actorUserId], references: [id])

  @@index([actorUserId])
  @@index([eventType])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("event_logs")
}

model AnalyticsEvent {
  id                           String   @id @default(uuid()) @db.Uuid
  eventId                      String   @unique @map("event_id")
  transitionKey                String   @unique @map("transition_key")
  eventName                    String   @map("event_name")
  eventVersion                 Int      @map("event_version")
  occurredAt                   DateTime @map("occurred_at")
  receivedAt                   DateTime @map("received_at")
  environment                  String
  trafficClass                 String   @map("traffic_class")
  trafficClassAssignmentSource String   @map("traffic_class_assignment_source")
  emittingLayer                String   @map("emitting_layer")
  analyticsIdKeyVersion        String?  @map("analytics_id_key_version")
  properties                   Json     @map("properties_json")
  createdAt                    DateTime @default(now()) @map("created_at")

  @@index([eventName])
  @@index([occurredAt])
  @@index([environment])
  @@index([trafficClass])
  @@map("analytics_events")
}

model ScoringScheme {
  id             String   @id @default(uuid()) @db.Uuid
  name           String
  subject        Subject
  examType       String   @map("exam_type")
  year           Int?
  maxRawScore    Int      @map("max_raw_score")
  maxScaledScore Int      @default(100) @map("max_scaled_score")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tests  Test[]
  scales ScoringScale[]

  @@index([subject])
  @@index([examType])
  @@index([isActive])
  @@map("scoring_schemes")
}

model ScoringScale {
  id              String   @id @default(uuid()) @db.Uuid
  scoringSchemeId String   @map("scoring_scheme_id") @db.Uuid
  rawScore        Int      @map("raw_score")
  scaledScore     Int      @map("scaled_score")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  scoringScheme ScoringScheme @relation(fields: [scoringSchemeId], references: [id])

  @@unique([scoringSchemeId, rawScore])
  @@index([scoringSchemeId])
  @@map("scoring_scales")
}

model EmailLog {
  id                String      @id @default(uuid()) @db.Uuid
  userId            String?     @map("user_id") @db.Uuid
  email             String
  type              String
  status            EmailStatus @default(PENDING)
  subject           String
  body              String?
  provider          String?
  providerMessageId String?     @map("provider_message_id")
  errorMessage      String?     @map("error_message")
  sentAt            DateTime?   @map("sent_at")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  user User? @relation("EmailLogUser", fields: [userId], references: [id])

  @@index([userId])
  @@index([email])
  @@index([status])
  @@map("email_logs")
}
