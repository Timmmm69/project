{
  "name": "ce-ct-online-tests-mvp",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "seed:admin": "node scripts/seed-admin.mjs",
    "seed:demo": "node scripts/seed-demo-content.mjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "setup:local": "pnpm db:up && pnpm prisma:migrate && pnpm prisma:generate && pnpm seed:admin && pnpm seed:demo"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "csv-parse": "7.0.0",
    "exceljs": "4.4.0",
    "next": "16.2.9",
    "nodemailer": "9.0.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "4.3.1",
    "@types/node": "26.0.1",
    "@types/nodemailer": "8.0.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@eslint/js": "9.39.4",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.9",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.62.1",
    "vitest": "3.2.6"
  }
}
